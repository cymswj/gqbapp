{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gqb.app/api/workflows.schema.json",
  "title": "GQB Workflow Catalog",
  "type": "object",
  "required": [
    "version",
    "philosophy",
    "workflows"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "philosophy": {
      "type": "string"
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "goal",
          "steps",
          "execution",
          "agentReady"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "tool",
                "purpose",
                "dependsOn",
                "inputStrategy",
                "outputKey"
              ],
              "properties": {
                "tool": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "purpose": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                },
                "id": {
                  "type": "string"
                },
                "dependsOn": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "inputStrategy": {
                  "type": "string",
                  "enum": [
                    "primary-input",
                    "previous-output",
                    "carry-forward",
                    "custom"
                  ]
                },
                "outputKey": {
                  "type": "string"
                }
              }
            }
          },
          "execution": {
            "type": "string"
          },
          "agentReady": {
            "type": "boolean"
          },
          "safety": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "sequential",
              "dag"
            ]
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              }
            }
          },
          "verification": {
            "type": "object",
            "required": [
              "mode",
              "required"
            ],
            "properties": {
              "mode": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              }
            }
          },
          "engine": {
            "type": "object",
            "required": [
              "status",
              "execution"
            ],
            "properties": {
              "status": {
                "type": "string"
              },
              "execution": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
