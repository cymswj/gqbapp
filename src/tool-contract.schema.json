{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gqb.app/api/tool-contract.schema.json",
  "title": "GQB Tool Contract",
  "type": "object",
  "required": [
    "contractVersion",
    "slug",
    "id",
    "implementation",
    "category",
    "names",
    "execution",
    "privacy",
    "inputSchema",
    "outputSchema",
    "errorSchema",
    "interfaces",
    "agent"
  ],
  "properties": {
    "contractVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^gqb:[a-z0-9-]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "implementation": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "names": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "execution": {
      "type": "string",
      "enum": [
        "browser-local",
        "browser-local-file",
        "external-data",
        "worker",
        "external"
      ]
    },
    "privacy": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "networkReason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "network": {
      "type": "boolean"
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object"
    },
    "errorSchema": {
      "type": "object"
    },
    "mimeTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "available"
          ]
        },
        "taskRouting": {
          "type": "boolean"
        }
      }
    },
    "deterministic": {
      "type": "boolean"
    },
    "idempotent": {
      "type": "boolean"
    },
    "stateful": {
      "type": "boolean"
    },
    "supportsBatch": {
      "type": "boolean"
    },
    "requiresConfirmation": {
      "type": "boolean"
    },
    "sideEffects": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
